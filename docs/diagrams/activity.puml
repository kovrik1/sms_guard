@startuml activity
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"

title Диаграмма деятельности: Поток обработки запроса на проверку SMS в системе SMS Guard

start
:Пользователь вводит текст SMS и отправляет форму (POST с CSRF-токеном);

if (Пользователь авторизован?) then (Нет)
    :Перенаправление на страницу входа / Ответ 401;
    stop
else (Да)
endif

if (Превышен лимит 30 проверок/мин?) then (Да)
    :Возврат ошибки 429 Too Many Requests;
    stop
else (Нет)
endif

if (Длина текста от 1 до 1000 символов\nи не состоит только из пробелов?) then (Нет)
    :Возврат ошибки валидации 400 (VALIDATION_ERROR);
    stop
else (Да)
endif

:Определение языка текста (ru, kk, en, other);
:Извлечение URL из текста регулярным выражением (до 3 ссылок);

fork
    partition "Ветвь анализа текста SMS" {
        :Нормализация и очистка текста (NFKC, нижний регистр,\nзамена сущностей на <url>, <phone>, <money>, <num>);
        :Векторизация TF-IDF (слова + символьные N-граммы)\nи классификация SMS-моделью -> P_sms;
        :Проверка по словарю правил социальной инженерии\n(срочность, банк/карта, блокировка, выигрыш, код, деньги);
        if (Язык текста входит в обучающую выборку?) then (Нет)
            :Добавление флага сниженной надёжности ML-оценки;
        else (Да)
        endif
    }
fork again
    partition "Ветвь анализа ссылок (URL)" {
        if (В тексте найдены ссылки?) then (Да)
            while (Для каждого найденного URL (до 3 шт.))
                :Нормализация схемы URL и разбор структуры без сетевого запроса;
                :Извлечение >= 20 лексических и структурных признаков\n(IP, поддомены, Punycode, сокращатели, расстояние Левенштейна);
                :Классификация URL-моделью -> P_url_i\n(SAFE / SUSPICIOUS / DANGEROUS);
            endwhile
            :Определение максимальной вероятности max(P_url_i);
        else (Нет)
            :P_url = None (ссылки отсутствуют);
        endif
    }
end fork

partition "Модуль оценки риска (Risk Engine)" {
    :Расчёт итогового показателя Risk Score (0..100)\nпо весам и порогам из risk_config.yaml;
    :Определение категории (SAFE / SUSPICIOUS / FRAUDULENT)\nи уровня риска (LOW / MEDIUM / HIGH);
    :Формирование списка причин срабатывания,\nрекомендации и обязательного дисклеймера;
}

partition "Сохранение результата (БД)" {
    if (В профиле включено согласие store_sms_text?) then (Да)
        :Сохранение исходного текста (input_text) и маскированной версии;
    else (Нет)
        :Маскирование телефонов, карт и сумм на ***\n(input_text = NULL, сохраняется только input_masked);
    endif
    :Запись в таблицы checks, url_results, detected_features;
    :Запись события в лог (только id проверки и категория, без текста SMS);
}

:Отображение результата пользователю\n(ссылки некликабельны, домен выделен);
stop

@enduml
